# Copy to .env (git-ignored). Placeholders only: never commit real values.
APP_ENV=local

# ports (fixed once, here): governance 8080, the organizers' test apps 8000
GOVERNANCE_PORT=8080

# the application connects as a restricted role (row-level security applies to it)
DATABASE_URL=postgresql://guardrail_app:CHANGE_ME@localhost:5432/guardrail_v2
# migrations run as the owner role, from a separate step, never from the app
MIGRATION_DATABASE_URL=postgresql://guardrail_owner:CHANGE_ME@localhost:5432/guardrail_v2

# Development-only password for the guardrail_app role. Use a unique secret in hosted environments.
APP_DB_PASSWORD=apppass

# vault keys: local files for development; hosted services use stable hex secrets
VAULT_KEY_PROVIDER=file
VAULT_KEY_FILE=./secrets/dev.key
VAULT_KEY_HEX=
AUTH_KEY_HEX=

# detection
ENABLE_NER=true
# LLM second opinion over already-masked text (catches names the rules miss, and prompt injection): off | auto | always
LLM_JUDGE=auto

# THE toggle: nebius (Token Factory + NVIDIA Nemotron) or local (company-hosted OpenAI-compatible model)
LLM_PROVIDER=nebius
UPSTREAM_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# nebius token factory
NEBIUS_API_KEY=nbtf-CHANGE_ME
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# used only when LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=https://ai-gpu-node.tailfa114b.ts.net/api/v1
LOCAL_LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
LOCAL_LLM_API_KEY=none

# tool gate: recipients outside these domains are denied on email tools
ALLOWED_EMAIL_DOMAINS=example.com

# agent hooks: when set, callers must send it as X-Veilgate-Key (leave empty for local development)
HOOK_API_KEY=
# Production dashboard account (created once; set both or neither)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
